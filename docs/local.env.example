# Settings for this machine. To use them, copy this file to local.env and remove the "#"
# in front of the lines you need. Git ignores local.env. Every line is optional.

# Where the Stargate repository is. Needed only when this project is NOT a folder
# directly inside the repository (the default is "the folder above this one").
#STARGATE_REPO=/mnt/c/path/to/stargate-exercise

# Where a build puts its results. The default is _build in this project. When this project
# sits on a Windows drive (/mnt/c/...), a folder in your WSL home makes builds faster:
#STARGATE_DOCS_BUILD=~/.cache/stargate-docs

# Where ./setup.sh puts the Python packages and Doxygen. The default is ~/.local/share/stargate-docs
#STARGATE_DOCS_TOOLS=~/.local/share/stargate-docs

# Your own Doxygen program instead of the one ./setup.sh downloads.
#DOXYGEN=/usr/local/bin/doxygen

# Where the running API publishes its description (the file Swagger shows). The default is the
# address in the API's own launch settings.
#STARGATE_OPENAPI_URL=http://localhost:5204/swagger/v1/swagger.json

# Test projects are left out of the code reference. This line puts them in.
#STARGATE_DOCS_TESTS=1

# The study document that the second site, the study companion, is made from. The default is
# stargate-api-and-patterns.md in the repository. Without that file there is no second site;
# to build without it on purpose, name a file that does not exist.
#STARGATE_COMPANION_DOC=/mnt/c/path/to/stargate-exercise/stargate-api-and-patterns.md
